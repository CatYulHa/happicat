# ─────────────────────────────────────────────────────────────
# HappiCat Moderation Service
# 아무 것도 채우지 않아도 실행된다(DRY_RUN: 결정론적 규칙 판정만 사용).
# .env 로 복사해서 필요한 값만 채우면 LLM/Slack 이 자동으로 켜진다.
# ─────────────────────────────────────────────────────────────

# ── LLM (택 1) ────────────────────────────────────────────────
# 1) NVIDIA Build API — 무료, OpenAI 호환. https://build.nvidia.com 에서 nvapi- 키 발급
NVIDIA_API_KEY=
# 2) OpenAI 를 쓰려면 이쪽만 채운다
OPENAI_API_KEY=

# 사용할 모델 (NVIDIA 예: z-ai/glm-5.2, meta/llama-3.3-70b-instruct / OpenAI 예: gpt-4.1-mini)
MODERATION_MODEL=z-ai/glm-5.2

# 위 키가 모두 비어 있으면 자동으로 true 처럼 동작한다. 강제로 LLM을 끄려면 true.
DRY_RUN=false

# ── Slack ────────────────────────────────────────────────────
# Incoming Webhook URL (https://api.slack.com/messaging/webhooks)
# 비워두면 알림 내용을 콘솔에 출력한다.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_HINT=#happicat-abuse-alert
# 이 값 이상의 risk_level 만 Slack 으로 보낸다 (0~5)
SLACK_MIN_RISK_LEVEL=1

# ── 어뷰징 판정 임계값 ─────────────────────────────────────────
# 이동 속도가 이 값을 넘으면 텔레포트(가짜 GPS)로 본다
MAX_TRAVEL_KMH=300
# GPS 정확도가 이 값보다 크면 신뢰도가 낮다고 본다 (m)
MAX_ACCURACY_M=200
# 반경 초과 허용 오차 (m) — GPS 오차를 감안한 완충값
RADIUS_TOLERANCE_M=30

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
