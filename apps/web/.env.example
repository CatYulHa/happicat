# ─────────────────────────────────────────────────────────────
# HappiCat Web — 모든 값은 선택 사항이다.
# 하나도 채우지 않아도 목업은 100% 동작한다(Mock 어댑터 + 폴백 지도).
# .env 로 복사해서 필요한 것만 채우면 자동으로 실연동으로 승격된다.
# ─────────────────────────────────────────────────────────────

# 카카오맵 JavaScript 키 (https://developers.kakao.com → 앱 → 앱 키 → JavaScript 키)
# 플랫폼 > Web 에 http://localhost:5173 도메인 등록 필수.
# 비워두면 좌표 기반 폴백 목업 지도로 자동 전환된다.
VITE_KAKAO_MAP_KEY=e9cf42e51a51bff0b160be31069e8035

# 어뷰징 판정 백엔드 (services/moderation). 비워두면 판정 요청을 건너뛴다.
VITE_MODERATION_API_URL=http://localhost:8080

# 데이터 소스: mock | firestore | supabase  (MVP는 mock만 구현되어 있음)
VITE_DB_ADAPTER=mock
